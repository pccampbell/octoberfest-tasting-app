# Replace this example IP with your server's LAN address or HTTPS hostname.
# For Windows/Cloudflare deployment, use deploy/cloudflare.env.example instead.
PUBLIC_APP_URL=http://192.168.1.50:8090
APP_PORT=8090
HOST_BIND=0.0.0.0

# Optional for Vite only. Leave empty to use Vite's same-origin API proxy.
VITE_POCKETBASE_URL=

# Only needed for the explicit development seed command. Never use VITE_ names.
ALLOW_DEV_SEED=no
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
